{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadSecretsUnderPrefix",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": "arn:aws:secretsmanager:*:ACCOUNT_ID_PLACEHOLDER:secret:SECRET_PREFIX_PLACEHOLDER"
    }
  ]
}
